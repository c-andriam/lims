<?xml version="1.0" encoding="UTF-8"?>
<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="senaite.trimeta.samplefields">

  <!-- 1000 -> 1001 : creation de l'index/colonne getSampleCode

       Cette etape n'est utile que pour une instance ou le profil avait
       ete installe AVANT l'introduction du catalogue (version 1000).
       Une installation neuve arrive directement en 1001 et n'execute
       pas cette etape. -->
  <genericsetup:upgradeStep
      title="Trimeta 1000 -> 1001 : index catalogue getSampleCode"
      description="Cree l'index et la colonne getSampleCode dans le
                   sample_catalog, puis reindexe les echantillons
                   existants."
      source="1000"
      destination="1001"
      handler=".v1001.upgrade"
      profile="senaite.trimeta.samplefields:default"
      />

  <!-- 1001 -> 1002 : colonnes du tableau de bord (lot 5)

       Provenance (index + colonne), poids a la reception, dates de
       debut et de fin d'analyse, operateurs HPLC / humidite /
       activite de l'eau. Reindexe les echantillons existants: sans
       cela le tableau de bord serait vide pour tout l'historique. -->
  <genericsetup:upgradeStep
      title="Trimeta 1001 -> 1002 : colonnes du tableau de bord"
      description="Cree l'index getOrigin et les colonnes de
                   metadonnees utilisees par le tableau de bord, puis
                   reindexe les echantillons existants."
      source="1001"
      destination="1002"
      handler=".v1002.upgrade"
      profile="senaite.trimeta.samplefields:default"
      />

  <!-- 1002 -> 1003 : index du type d'echantillon

       Filtre "Type d'echantillon" du tableau de bord. senaite.core
       n'indexe pas ce champ sur le sample_catalog: on ajoute le
       notre. Reindexe les echantillons existants. -->
  <genericsetup:upgradeStep
      title="Trimeta 1002 -> 1003 : index du type d'echantillon"
      description="Cree l'index getTrimetaSampleTypeUID dans le
                   sample_catalog, puis reindexe les echantillons
                   existants."
      source="1002"
      destination="1003"
      handler=".v1003.upgrade"
      profile="senaite.trimeta.samplefields:default"
      />

  <!-- 1004 -> 1005 : la configuration passe du mode d'emploi au code

       Le laboratoire n'a pas a connaitre les reglages avances de
       SENAITE pour que le logiciel se comporte correctement. Cette
       etape pose le gabarit de publication unitaire par defaut (D11),
       cree les calculs de moyenne sur repetitions et les rattache aux
       services (D9), et accorde le role Analyst aux comptes existants
       (D7). Idempotente: aucun reglage deja pose n'est ecrase. -->
  <genericsetup:upgradeStep
      title="Trimeta 1004 -> 1005 : configuration livree en code"
      description="Gabarit COA unitaire par defaut, calculs de moyenne
                   sur repetitions rattaches aux services, role
                   Analyst sur les comptes existants."
      source="1004"
      destination="1005"
      handler=".v1005.upgrade"
      profile="senaite.trimeta.samplefields:default"
      />

  <!-- 1003 -> 1004 : nommage des COA par le Code echantillon

       Active la couche de navigateur ITrimetaLayer, qui porte les
       surcharges des trois endroits ou senaite.core fabrique le nom
       d'un fichier COA. Sans cette etape, une instance deja installee
       garderait le nommage par Sample ID: browserlayer.xml n'est lu
       qu'a l'installation du profil. Instantanee, aucune
       reindexation. -->
  <genericsetup:upgradeStep
      title="Trimeta 1003 -> 1004 : nommage des COA par le Code echantillon"
      description="Active la couche de navigateur qui fait nommer les
                   fichiers COA d'apres le Code echantillon au lieu du
                   Sample ID."
      source="1003"
      destination="1004"
      handler=".v1004.upgrade"
      profile="senaite.trimeta.samplefields:default"
      />

</configure>
