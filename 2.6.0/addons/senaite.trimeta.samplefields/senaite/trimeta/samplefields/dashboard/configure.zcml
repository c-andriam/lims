<?xml version="1.0" encoding="UTF-8"?>
<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    i18n_domain="senaite.trimeta.samplefields">

  <!-- Tableau de bord: /senaite/trimeta-dashboard

       La declaration reprend a l'identique celle des vues auxiliaires
       de senaite.core (browser/samples/configure.zcml): un contexte
       quelconque, la permission zope2.View et la couche ISenaiteCore.

       Pourquoi zope2.View et non une permission plus restrictive: le
       sample_catalog filtre deja par allowedRolesAndUsers. Un contact
       client qui ouvrirait la page n'y verrait que ses propres
       echantillons. C'est le meme raisonnement que senaite.core tient
       pour partition_magic et dispatch_samples, ou une permission plus
       fine empechait les roles partages d'atteindre la vue depuis le
       listing global.

       for="*" plutot qu'une interface precise: la page ne depend pas
       de son contexte, elle interroge le catalogue. Une interface
       devenue fausse au fil des versions 2.x ferait echouer le
       chargement du ZCML, donc le demarrage complet de l'instance. -->
  <browser:page
      for="*"
      name="trimeta-dashboard"
      class=".view.DashboardView"
      permission="zope2.View"
      layer="senaite.core.interfaces.ISenaiteCore"
      />

  <!-- Barre de filtres, posee DANS la zone de contenu.

       Elle ne peut pas etre rendue par la vue elle-meme: senaite.app.
       listing reutilise celle-ci pour ses requetes AJAX, et tout HTML
       ajoute a son rendu se retrouve devant la reponse JSON. Symptome
       constate: "JSON.parse: unexpected character at line 1 column 1"
       et un tableau qui reste vide.

       Le manager IAboveContentBody place le viewlet au-dessus du
       contenu, sous le titre de la page. Meme paquet que les viewlets
       de la section Assurance Qualite, deja en service ici. -->
  <browser:viewlet
      name="senaite.trimeta.samplefields.dashboard_filters"
      manager="plone.app.layout.viewlets.interfaces.IAboveContentBody"
      class=".viewlets.DashboardFiltersViewlet"
      permission="zope2.View"
      layer="senaite.core.interfaces.ISenaiteCore"
      />

  <!-- Entree de barre laterale et infobulles d'en-tete.

       Sur IHtmlHead et sur TOUTES les pages: le raccourci vers le
       tableau de bord doit exister partout, pas seulement une fois
       qu'on y est. Meme manager et meme couche que les viewlets de la
       section Assurance Qualite, deja en service ici.

       La barre laterale de senaite.core n'offre pas de point
       d'extension: le script CLONE une entree existante et n'en change
       que le lien, le libelle et l'icone. Il herite ainsi du balisage
       et des classes exacts du theme, au lieu de parier dessus. -->
  <browser:viewlet
      name="senaite.trimeta.samplefields.dashboard_script"
      manager="plone.app.layout.viewlets.interfaces.IHtmlHead"
      class=".viewlets.DashboardScriptViewlet"
      permission="zope2.View"
      layer="bika.lims.interfaces.IBikaLIMS"
      />

</configure>
