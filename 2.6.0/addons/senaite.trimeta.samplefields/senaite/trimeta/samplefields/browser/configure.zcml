<?xml version="1.0" encoding="UTF-8"?>
<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    i18n_domain="senaite.trimeta.samplefields">

  <!-- Sert le dossier resources/ sous
       ++resource++senaite.trimeta.samplefields.static -->
  <browser:resourceDirectory
      name="senaite.trimeta.samplefields.static"
      directory="resources"
      />

  <!-- Formulaire de creation d'echantillon -->
  <browser:viewlet
      name="senaite.trimeta.samplefields.reception_separator"
      manager="plone.app.layout.viewlets.interfaces.IHtmlHead"
      class=".viewlets.ReceptionSeparatorViewlet"
      permission="zope2.View"
      layer="bika.lims.interfaces.IBikaLIMS"
      />

  <!-- Formulaires de modification: sous-sections Assurance Qualite -->
  <browser:viewlet
      name="senaite.trimeta.samplefields.quality_sections"
      manager="plone.app.layout.viewlets.interfaces.IHtmlHead"
      class=".viewlets.QualitySectionsViewlet"
      permission="zope2.View"
      layer="bika.lims.interfaces.IBikaLIMS"
      />

  <!-- API JSON pour lister/supprimer les suggestions dynamiques -->
  <browser:page
      for="*"
      name="trimeta-suggestions"
      class=".suggestions_api.SuggestionsAPI"
      permission="zope2.View"
      layer="bika.lims.interfaces.IBikaLIMS"
      />

</configure>
