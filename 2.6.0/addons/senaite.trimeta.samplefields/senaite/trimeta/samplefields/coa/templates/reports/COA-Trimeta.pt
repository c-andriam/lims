<tal:report
    define="model view/model"
    i18n:domain="senaite.trimeta.coa">

  <!-- Domaine de traduction propre, sans catalogue: le COA reste en
       anglais, comme le cahier des charges le specifie ("Sample
       reference", "Report reference", "ORGANOLEPTIC ANALYSIS"...).
       Sous senaite.impress, le catalogue francais de l'add-on (ecran de
       publication) traduisait une partie des libelles seulement: le COA
       melangeait les deux langues. -->

  <!-- Gabarit COA Trimeta (lot 4).

       Copie de la structure de senaite.impress:Default.pt: memes
       sections REPORT CONTROLS/JS/CSS/HEADER/INFO/ALERTS, rendues via
       les memes methodes de vue (view.render_*), pour ne pas s'ecarter
       du comportement natif (barcode, alertes, pieces jointes,
       signatures...).

       Deux differences, demandees par le cahier des charges:

       1. Le tableau "Summary" natif est remplace par un tableau
          equivalent, complete des champs Trimeta (poids a la
          reception, debut/fin d'analyse, validateur final) et sans le
          lien mailto sur "Published by".
       2. Deux tableaux sont ajoutes a la suite: "Sample information"
          (temperature, designation, lot, client) et "Organoleptic
          analysis" (texture, couleur, arome).

       Les champs lus ci-dessous (model/ReceptionWeight,
       model/AnalysisStart, model/Texture, ...) viennent du
       schemaextender de ce meme add-on: voir extender.py et
       qualitydata/extender.py. SuperModel les expose par leur NOM DE
       CHAMP (pas l'accesseur get*): c'est le meme mecanisme que
       model/ClientSampleID ou model/DateReceived ci-dessous, deja
       utilises par le gabarit natif. -->

  <!-- REPORT CONTROLS -->
  <tal:t replace="structure python:view.render_controls(context, **options)" />

  <!-- REPORT JS -->
  <tal:t replace="structure python:view.render_js(context, **options)" />

  <!-- REPORT CSS -->
  <tal:t replace="structure python:view.render_css(context, **options)" />

  <!-- REPORT HEADER -->
  <tal:t replace="structure python:view.render_header(context, **options)" />

  <!-- REPORT INFO -->
  <tal:t replace="structure python:view.render_info(context, **options)" />

  <!-- REPORT ALERTS -->
  <tal:t replace="structure python:view.render_alerts(context, **options)" />

  <!-- REPORT SUMMARY (version Trimeta, cf. note en tete de fichier) -->
  <tal:t define="client model/Client;
                 reporter python:view.current_user;">
    <div class="row section-summary no-gutters">
      <div class="w-100">

        <!-- Barcode -->
        <div class="text-center float-right barcode-container">
          <div class="barcode"
               data-code="code128"
               data-showHRI="true"
               data-barHeight="15"
               data-addQuietZone="true"
               tal:attributes="data-id model/getId">
          </div>
        </div>

        <h1 i18n:translate="">Summary</h1>

        <table class="table table-sm table-condensed">
          <tr>
            <td style="width:20%" class="label" i18n:translate="">Sample ID</td>
            <td>
              <a tal:content="model/getId"
                 tal:attributes="href model/absolute_url;">
              </a>
            </td>
          </tr>
          <tr>
            <!-- "Report reference" du cahier des charges: le Code
                 echantillon. Le meme document demande que le COA porte le
                 nom du Code echantillon: c'est la reference sous laquelle
                 le rapport circule, et le nom de son PDF. L'identifiant
                 de l'ARReport n'existe pas encore au rendu (senaite.impress
                 produit le PDF AVANT de creer l'ARReport). Le Numero de
                 fiche d'analyse sert de repli si le code manque. -->
            <td class="label" i18n:translate="">Report reference</td>
            <td tal:content="python:model.SampleCode or model.AnalysisSheetNumber or ''"></td>
          </tr>
          <tr>
            <td class="label" i18n:translate="">Sample Type</td>
            <td tal:content="model/SampleType/title|nothing"></td>
          </tr>
          <tr>
            <td class="label" i18n:translate="">Specification</td>
            <td tal:content="model/Specification/contextual_title|nothing"></td>
          </tr>
          <tr>
            <td class="label" i18n:translate="">Date Received</td>
            <td tal:content="python:view.to_localized_time(model.DateReceived)"></td>
          </tr>
          <tr>
            <td class="label" i18n:translate="">Beginning of analysis</td>
            <td tal:content="python:view.to_localized_time(model.AnalysisStart)"></td>
          </tr>
          <tr>
            <td class="label" i18n:translate="">End of analysis</td>
            <td tal:content="python:view.to_localized_time(model.AnalysisEnd)"></td>
          </tr>
          <tr>
            <td class="label" i18n:translate="">Date Validated</td>
            <td tal:content="python:view.to_localized_time(model.getDateVerified())"></td>
          </tr>
          <tr>
            <td class="label" i18n:translate="">Validated by</td>
            <td tal:content="model/FinalValidator/Fullname|nothing"></td>
          </tr>
          <tr>
            <td class="label" i18n:translate="">Date Published</td>
            <td tal:content="python:view.to_localized_time(view.timestamp)"></td>
          </tr>
          <tr tal:condition="reporter">
            <!-- Nom seul, sans l'adresse e-mail ("supprimer l'adresse
                 mail"). Nom complet, sinon identifiant: un compte sans
                 nom complet laissait la cellule vide. -->
            <td class="label" i18n:translate="">Published by</td>
            <td tal:content="python:reporter.get('fullname') or reporter.get('username')"></td>
          </tr>
          <tr>
            <td class="label" i18n:translate="">Sample weight</td>
            <td tal:content="model/ReceptionWeight|nothing"></td>
          </tr>
        </table>

        <!-- SAMPLE INFORMATION -->
        <h2 i18n:translate="">Sample information</h2>
        <table class="table table-sm table-condensed">
          <tr>
            <td style="width:20%" class="label" i18n:translate="">Reception temperature</td>
            <td tal:content="model/ReceptionTemperature|nothing"></td>
          </tr>
          <tr>
            <td class="label" i18n:translate="">Designation</td>
            <td tal:content="model/Designation|nothing"></td>
          </tr>
          <tr>
            <td class="label" i18n:translate="">Lot</td>
            <td tal:content="model/ClientSampleID|nothing"></td>
          </tr>
          <tr>
            <td class="label" i18n:translate="">Client</td>
            <td>
              <a tal:condition="client"
                 tal:attributes="href client/absolute_url"
                 tal:content="client/Name"></a>
            </td>
          </tr>
        </table>

        <!-- ORGANOLEPTIC ANALYSIS -->
        <h2 i18n:translate="">Organoleptic analysis</h2>
        <table class="table table-sm table-condensed">
          <tr>
            <td style="width:20%" class="label" i18n:translate="">Texture</td>
            <td tal:content="model/Texture|nothing"></td>
          </tr>
          <tr>
            <td class="label" i18n:translate="">Color</td>
            <td tal:content="model/Color|nothing"></td>
          </tr>
          <tr>
            <td class="label" i18n:translate="">Aroma</td>
            <td tal:content="model/Aroma|nothing"></td>
          </tr>
        </table>

      </div>
    </div>
  </tal:t>

  <!-- REPORT RESULTS -->
  <tal:t replace="structure python:view.render_results(context, **options)" />

  <!-- RESULTS INTERPRETATION -->
  <tal:t replace="structure python:view.render_interpretations(context, **options)" />

  <!-- SAMPLE REMARKS -->
  <tal:t replace="structure python:view.render_remarks(context, **options)" />

  <!-- REPORT ATTACHMENTS -->
  <tal:t replace="structure python:view.render_attachments(context, **options)" />

  <!-- REPORT SIGNATURES (copie de senaite.impress signatures.pt, sans
       l'adresse e-mail de "Published by") -->
  <tal:t define="collection view/collection;
                 managers python:view.uniquify_items(reduce(lambda a1, a2: a1+a2, map(lambda m: m.managers, collection)))">
    <div class="row section-signatures no-gutters">
      <div class="w-100">
        <h1 i18n:translate="">Responsibles</h1>
        <table class="table table-sm table-condensed">
          <tr>
            <tal:manager repeat="manager managers">
              <td style="border:none">
                <div>
                  <img tal:condition="manager/Signature"
                       tal:attributes="src string:${manager/absolute_url}/Signature" style="height:75px"/>
                </div>
                <div class="font-weight-bold">
                  <span tal:content="manager/Salutation"></span>
                  <span tal:condition="manager/Salutation">&nbsp;</span>
                  <span tal:content="manager/Fullname"></span>
                </div>
                <div>
                  <span tal:content="manager/JobTitle"></span>
                </div>
                <div>
                  <span tal:content="manager/DefaultDepartment/title|nothing"></span>
                </div>
              </td>
            </tal:manager>
            <tal:reporter define="reporter python:view.current_user" condition="reporter">
              <td style="border:none">
                <div class="label" i18n:translate="">Published by</div>
                <div tal:content="python:reporter.get('fullname') or reporter.get('username')"></div>
              </td>
            </tal:reporter>
          </tr>
        </table>
      </div>
    </div>
  </tal:t>

  <!-- REPORT DISCREETER -->
  <tal:t replace="structure python:view.render_discreeter(context, **options)" />

  <!-- REPORT FOOTER -->
  <tal:t replace="structure python:view.render_footer(context, **options)" />

</tal:report>
