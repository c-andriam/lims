<?xml version="1.0" encoding="UTF-8"?>
<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="senaite.trimeta.samplefields">

  <!-- Declare senaite.core.permissions.* avant les vues ci-dessous: sans
       cela Zope refuse de demarrer (ComponentLookupError sur
       IPermission), l'add-on etant charge avant senaite.core. -->
  <include package="senaite.core.permissions" />

  <!-- Gabarit COA Trimeta: ajoute au selecteur "Gabarit" de l'ecran de
       publication, a cote de Default.pt/MultiDefault.pt.

       Decouvert par le meme mecanisme que senaite.impress utilise pour
       ses propres gabarits: un repertoire de ressources Plone du type
       "senaite.impress.reports" (voir senaite.impress.template.
       TemplateFinder). Rien n'est modifie dans senaite.impress: le
       gabarit existant reste disponible et reste le choix par defaut.

       Etre decouvrable ne suffit pas a etre propose: la liste des
       gabarits actifs est un enregistrement du registre Plone, auquel
       setuphandlers.register_coa_template() nous ajoute. -->
  <plone:static
      directory="templates/reports"
      type="senaite.impress.reports"
      name="senaite.trimeta.samplefields"
      />

  <!-- Nom des PDF: Code echantillon au lieu de l'ID (voir views.py).

       Memes noms, memes "for" et memes permissions que dans
       bika/lims/browser/publish/configure.zcml et
       bika/lims/browser/workflow/configure.zcml. Seule la couche change:
       ISenaiteTrimetaLayer etend IBikaLIMS, elle est donc plus
       specifique et gagne. Tant que browserlayer.xml n'a pas ete importe
       (profil non installe ou etape 1004 non jouee), les vues de
       senaite.core restent actives. -->
  <browser:page
      for="*"
      name="download_pdf"
      class=".views.TrimetaDownloadView"
      permission="senaite.core.permissions.ManageAnalysisRequests"
      layer="senaite.trimeta.samplefields.interfaces.ISenaiteTrimetaLayer"
      />

  <browser:page
      for="bika.lims.interfaces.IClient"
      name="email"
      class=".views.TrimetaEmailView"
      permission="senaite.core.permissions.ManageAnalysisRequests"
      layer="senaite.trimeta.samplefields.interfaces.ISenaiteTrimetaLayer"
      />

  <browser:page
      for="bika.lims.interfaces.IAnalysisRequest"
      name="email"
      class=".views.TrimetaEmailView"
      permission="senaite.core.permissions.ManageAnalysisRequests"
      layer="senaite.trimeta.samplefields.interfaces.ISenaiteTrimetaLayer"
      />

  <adapter
      name="workflow_action_download_reports"
      for="bika.lims.interfaces.IClient
           senaite.trimeta.samplefields.interfaces.ISenaiteTrimetaLayer"
      factory=".views.TrimetaDownloadReportsAdapter"
      provides="bika.lims.interfaces.IWorkflowActionAdapter"
      permission="zope.Public"
      />

  <adapter
      name="workflow_action_download_reports"
      for="bika.lims.interfaces.IAnalysisRequest
           senaite.trimeta.samplefields.interfaces.ISenaiteTrimetaLayer"
      factory=".views.TrimetaDownloadReportsAdapter"
      provides="bika.lims.interfaces.IWorkflowActionAdapter"
      permission="zope.Public"
      />

</configure>
