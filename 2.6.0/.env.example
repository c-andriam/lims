# Configuration propre a chaque machine. Copier en .env et adapter :
#
#     cp .env.example .env
#
# .env n'est pas versionne: chaque serveur a son adresse et ses ports
# libres, et les figer dans le depot obligerait a les corriger a chaque
# deploiement.

# Port publie sur l'hote. Change-le si un autre service occupe deja
# 8080 sur cette machine. Verifier avant de choisir :
#     ss -tln | grep -E ':(8080|8081|8090)'
SENAITE_PORT=8080

# Adresse par laquelle les utilisateurs atteignent SENAITE. Sert
# uniquement a afficher la bonne URL dans les messages du Makefile.
SENAITE_HOST=localhost
